# 복사해서 .env 로 만들고 값을 채운다. .env 는 커밋하지 않는다.
PORT=3000
# Supabase 대시보드 > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:[비밀번호]@[호스트]:5432/postgres
# 로그인 토큰 서명용 비밀 값(길고 무작위로): openssl rand -hex 48
JWT_SECRET=
# Gemini API 키(Google AI Studio > Get API key). 서버에서만 사용
GEMINI_API_KEY=
# 사용할 Gemini 모델 이름(AI 구현 때 실제 호출로 확인한 값을 넣는다)
AI_MODEL=
